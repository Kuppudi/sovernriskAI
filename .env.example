# Development credentials only. Change before exposing any service.
POSTGRES_DB=sovereign_risk
POSTGRES_USER=sovereign
POSTGRES_PASSWORD=local_dev_only
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://sovereign:local_dev_only@localhost:5432/sovereign_risk
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
RAW_DATA_DIR=data/raw
WORLD_BANK_BASE_URL=https://api.worldbank.org/v2
# Vite proxies /api and /health to this address in development.
API_PROXY_TARGET=http://127.0.0.1:8000
# Frontend requests use the page's own URL, including in Azure App Service.
# Optional override; the frontend build is normally found automatically.
# FRONTEND_DIR=/absolute/path/to/frontend/dist
